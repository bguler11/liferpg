# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
# iOS'ta ana ekran uygulamasından giriş için: konsoldaki <proje>.firebaseapp.com yerine
# sitenin kendi alan adını yaz (<proje>.web.app). Yönlendirme aynı kökende kalır.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Project settings > Cloud Messaging > Web Push certificates > Generate key pair
# Boş bırakılırsa bildirim özelliği kapalı görünür, uygulamanın kalanı çalışır.
VITE_FIREBASE_VAPID_KEY=
